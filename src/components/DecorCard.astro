---
const projects = [
  {
    name: "Argus",
    href: "https://heyargus.app",
    domain: "heyargus.app",
    logo: "/brand/argus.svg",
  },
  {
    name: "Smingle",
    href: "https://smingle.in",
    domain: "smingle.in",
    logo: "/brand/smingle.svg",
  },
  {
    name: "Gymifi",
    href: "https://gymifi.fit",
    domain: "gymifi.fit",
    logo: "/brand/gymifi.png",
  },
];
---

<aside class="decor card" aria-label="Currently building">
  <svg class="decor-bg" viewBox="0 0 353 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="d-warm" cx="35%" cy="20%" r="80%">
        <stop offset="0%" stop-color="#fef3c7" stop-opacity="0.9" />
        <stop offset="60%" stop-color="#fafafa" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="d-cool" cx="80%" cy="85%" r="70%">
        <stop offset="0%" stop-color="#dbeafe" stop-opacity="0.8" />
        <stop offset="60%" stop-color="#fafafa" stop-opacity="0" />
      </radialGradient>
      <pattern id="d-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="12" cy="12" r="1.1" fill="currentColor" opacity="0.18" />
      </pattern>
    </defs>
    <rect width="353" height="520" fill="url(#d-warm)" />
    <rect width="353" height="520" fill="url(#d-cool)" />
    <rect width="353" height="520" fill="url(#d-grid)" class="decor-dots" />
  </svg>

  <div class="decor-content">
    <div class="decor-pill">
      <span class="decor-dot" aria-hidden="true"></span>
      <span>Currently building</span>
    </div>

    <div class="decor-projects">
      {projects.map((p) => (
        <a href={p.href} target="_blank" rel="noopener noreferrer" class="decor-project">
          <img src={p.logo} alt="" width="40" height="40" class="decor-project-logo" loading="eager" decoding="async" />
          <div class="decor-project-text">
            <p class="decor-project-name">{p.name}</p>
            <p class="decor-project-domain">{p.domain}</p>
          </div>
          <span class="decor-project-go" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</aside>

<style>
  .decor {
    position: relative;
    overflow: hidden;
    height: 100%;
    width: 100%;
  }

  .decor-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #6b7280;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .decor-bg :global(stop) { stop-color: #27272a; }
  :global([data-theme="dark"]) .decor-dots { opacity: 0.4; }

  .decor-content {
    position: relative;
    height: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .decor-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05) inset;
  }

  :global([data-theme="dark"]) .decor-pill {
    background: rgba(24, 24, 27, 0.7);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .decor-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #15a34a;
    box-shadow: 0 0 8px rgba(21, 163, 74, 0.6);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .decor-projects {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .decor-project {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-radius: 14px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06) inset, 0 8px 24px -8px rgba(0, 0, 0, 0.12);
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .decor-project:hover { background: rgba(255, 255, 255, 0.92); }

  :global([data-theme="dark"]) .decor-project {
    background: rgba(24, 24, 27, 0.7);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 8px 24px -8px rgba(0, 0, 0, 0.5);
  }

  :global([data-theme="dark"]) .decor-project:hover { background: rgba(26, 26, 26, 0.88); }

  .decor-project-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--card);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06) inset;
  }

  :global([data-theme="dark"]) .decor-project-logo {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .decor-project-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .decor-project-name {
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .decor-project-domain {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--fg-soft);
  }

  .decor-project-go {
    font-size: 16px;
    color: var(--fg-soft);
    flex-shrink: 0;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), color 200ms ease;
  }

  .decor-project:hover .decor-project-go {
    transform: translate(2px, -2px);
    color: var(--fg);
  }
</style>

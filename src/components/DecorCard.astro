---
import AnimatedArrow from "~/components/AnimatedArrow.astro";
---

<a href="/projects" class="decor card" data-project-collection aria-labelledby="collection-label" aria-describedby="collection-note">
  <canvas class="decor-bg" data-dot-field aria-hidden="true"></canvas>
  <span class="decor-label" id="collection-label">Why do I build these...</span>
  <span class="decor-collection-note" id="collection-note">
    Explore the collection
    <AnimatedArrow size={20} />
  </span>
</a>

<style>
  .decor {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    height: 100%;
    width: 100%;
    padding: 20px;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .decor:hover { box-shadow: var(--card-shadow-hover); }
  .decor:focus-visible { outline: 2px solid var(--fg-muted); outline-offset: 4px; }

  .decor-bg {
    --dot-field-from: #5227FF;
    --dot-field-to: #FF9FFC;
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: .65;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent);
            mask-image: linear-gradient(to bottom, #000, transparent);
    pointer-events: none;
  }

  .decor-label, .decor-collection-note { position: relative; }

  .decor-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .decor-collection-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
  }
</style>

<script>
  import { startDotField } from "~/scripts/dot-field";

  document.querySelectorAll<HTMLElement>("[data-project-collection]").forEach((card) => {
    const stop = startDotField(card, {
      bulgeStrength: 0.2,
      glowRadius: 190,
      cursorRadius: 170,
      lightMode: true,
    });
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) stop();
    }, { once: true });
  });
</script>

---
import Icons from "./Icons.astro";
---

<div class="work-with-me card" role="group" aria-label="Work with me">
  <h2 class="wwm-title">Work with me</h2>

  <div class="wwm-discs" aria-hidden="true">
    <span class="wwm-disc wwm-disc-contra">
      <Icons name="contra" size={18} />
    </span>
    <span class="wwm-disc wwm-disc-upwork">
      <Icons name="upwork" size={18} />
    </span>
  </div>
</div>

<style>
  .work-with-me {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 20px;
    overflow: hidden;
  }

  .wwm-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--fg);
    margin: 0;
    max-width: 70%;
  }

  .wwm-discs {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
  }

  .wwm-disc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--rule), 0 2px 6px 0 rgba(0, 0, 0, 0.08);
  }

  .wwm-disc + .wwm-disc {
    margin-left: -14px;
  }

  .wwm-disc-contra { color: #fb4f14; z-index: 2; }
  .wwm-disc-upwork { color: #14a800; z-index: 1; }
</style>

---
import Icons from "./Icons.astro";
import SquiggleArrow from "./SquiggleArrow.astro";
---

<a href="/work" class="work-with-me card" aria-label="Work with me" data-arrow-trigger>
  <SquiggleArrow
    viewBox="0 0 428 212"
    path="M 150 46 C 185 30 210 75 178 92 C 146 109 122 78 152 62 C 190 40 245 55 240 95 C 236 130 195 140 210 158 C 222 172 260 178 285 168 C 305 160 322 168 338 164"
    arrowHeadPoint={{ x: 338, y: 164 }}
    arrowHeadRotation={24}
  />

  <h2 class="wwm-title">Work with me</h2>

  <div class="wwm-discs" aria-hidden="true">
    <span class="wwm-disc wwm-disc-contra">
      <Icons name="contra" size={18} />
    </span>
    <span class="wwm-disc wwm-disc-upwork">
      <Icons name="upwork" size={18} />
    </span>
  </div>
</a>

<style>
  .work-with-me {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: background-color 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-with-me:hover {
    background: var(--card-hover);
  }

  .wwm-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--fg);
    margin: 0;
    max-width: 70%;
  }

  .wwm-discs {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
  }

  .wwm-disc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--rule), 0 2px 6px 0 rgba(0, 0, 0, 0.08);
  }

  .wwm-disc + .wwm-disc {
    margin-left: -14px;
  }

  .wwm-disc-contra { color: #fb4f14; z-index: 2; }
  .wwm-disc-upwork { color: #14a800; z-index: 1; }
</style>

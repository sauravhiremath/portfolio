---
import SakuraArt from "~/components/SakuraArt.astro";
import SakuraPetals from "~/components/SakuraPetals.astro";
import "~/styles/sakura-scene.css";
---

<div class="sakura-backdrop" aria-hidden="true">
  <img class="sakura-landscape" src="/misty-landscape.webp" width="1774" height="887" alt="" fetchpriority="high" />
  <SakuraPetals depth="background" />
  <SakuraArt />
</div>
<SakuraPetals depth="foreground" />

<noscript>
  <style is:inline>
    .sakura-hero.is-initializing [data-sakura-blooms],
    .home-petals.is-initializing { visibility: visible; }
    .home-petals.is-initializing .home-petals__fall { animation: none; opacity: .55; transform: translateY(var(--rest-y)); }
    .home-petals.is-initializing .home-petals__sprite { animation: none; }
  </style>
</noscript>

<script src="~/scripts/sakura-scene.ts"></script>

---
import Icons from "./Icons.astro";
import { email } from "~/data/site";
---

<a href={email.href} class="email card-link">
  <span class="email-icon" aria-hidden="true">
    <Icons name="mail" size={18} />
  </span>
  <span class="email-text">{email.label}</span>
</a>

<style>
  .email {
    color: var(--fg);
    text-decoration: none;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    height: 100%;
  }

  .email-icon {
    color: var(--fg-muted);
    display: inline-flex;
    flex-shrink: 0;
  }

  .email-text {
    font-size: 16px;
    font-weight: 500;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

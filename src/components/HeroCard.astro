---
import { Image } from "astro:assets";
import { site } from "~/data/site";
import avatar from "~/assets/saurav.webp";
---

<article class="hero card">
  <div class="hero-head">
    <Image
      src={avatar}
      width={40}
      height={40}
      densities={[1, 2]}
      alt={site.shortName}
      class="hero-avatar"
      priority
    />
    <h1 class="hero-greeting">
      Hey, I'm {site.shortName} <span class="animate-wave" aria-hidden="true">👋🏽</span>
    </h1>
  </div>

  <p class="hero-copy">
    I'm a senior dev <a href="https://orca.security" target="_blank" rel="noopener noreferrer" class="link-orca">@orca</a>
    building cool AI things and R&amp;D for API security. A digital nomad discovering and exploring possibilities.
  </p>

  <div class="hero-meta">
    <p class="hero-location">{site.location.label} <span aria-hidden="true">{site.location.flag}</span></p>
    <p class="hero-time" data-local-time>—</p>
  </div>

  <div class="globe-wrap" aria-hidden="true">
    <canvas class="globe-canvas" data-globe></canvas>
  </div>

  <div class="weather-card" data-weather aria-hidden="true">
    <span class="weather-emoji" data-weather-emoji></span>
    <div class="weather-info">
      <p class="weather-city">Bangalore</p>
      <p class="weather-temp" data-weather-temp></p>
    </div>
  </div>
</article>

<style>
  .hero {
    width: 711px;
    height: 520px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero-head {
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    z-index: 2;
  }

  .hero-avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    object-fit: cover;
    background: var(--pop);
    flex-shrink: 0;
  }

  .hero-greeting {
    font-size: 28px;
    font-weight: 500;
    line-height: 32px;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .hero-copy {
    margin-top: 28px;
    font-size: 24px;
    line-height: 40px;
    font-weight: 400;
    color: var(--fg);
    max-width: 540px;
    position: relative;
    z-index: 2;
  }

  .link-orca {
    color: #0080ff;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 200ms ease;
  }
  .link-orca:hover { opacity: 0.75; }

  .hero-meta {
    margin-top: auto;
    position: relative;
    z-index: 2;
  }

  .hero-location {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--fg);
  }

  .hero-time {
    font-size: 15px;
    font-weight: 500;
    line-height: 24px;
    color: var(--fg-soft);
  }

  .globe-wrap {
    position: absolute;
    right: -87px;
    bottom: -132px;
    width: 450px;
    height: 450px;
    pointer-events: none;
    z-index: 1;
    -webkit-mask-image: radial-gradient(circle, #000 60%, transparent 70%);
            mask-image: radial-gradient(circle, #000 60%, transparent 70%);
  }

  .globe-canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
  }
  .globe-canvas:active { cursor: grabbing; }

  .weather-card {
    position: absolute;
    position-anchor: --cobe-bangalore;
    bottom: anchor(top);
    left: anchor(center);
    translate: -50% -10px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 10px;
    background: var(--card);
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    white-space: nowrap;
    pointer-events: none;
    z-index: 3;
    opacity: var(--cobe-visible-bangalore, 0);
    filter: blur(var(--cobe-visible-bangalore, 6px));
    transition: opacity 320ms cubic-bezier(.22,1,.36,1), filter 320ms cubic-bezier(.22,1,.36,1);
  }

  .weather-emoji {
    font-size: 22px;
    line-height: 1;
    position: relative;
    display: inline-block;
    vertical-align: middle;
  }

  .weather-emoji:empty {
    width: 22px;
    height: 22px;
  }

  .weather-info { display: flex; flex-direction: column; line-height: 1.1; }

  .weather-city {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
  }

  .weather-temp {
    font-size: 11px;
    font-weight: 500;
    color: var(--fg-soft);
    font-variant-numeric: tabular-nums;
    position: relative;
  }

  .weather-temp:empty {
    width: 88px;
    height: 12px;
  }

  .weather-emoji::before,
  .weather-temp::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--pop);
    border-radius: 999px;
    transition: opacity 280ms cubic-bezier(.22, 1, .36, 1);
  }

  .weather-emoji:not(:empty)::before,
  .weather-temp:not(:empty)::before {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-emoji::before,
    .weather-temp::before {
      content: none;
    }
  }

  @supports not (anchor-name: --x) {
    .weather-card { display: none; }
  }
</style>

<script>
  function mountGlobe() {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-globe]");
    if (!canvas) return;

    const staticFrame = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const load = () =>
      import("~/scripts/globe").then(({ startGlobe }) => startGlobe(canvas, { staticFrame }));

    const setupIO = () => {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(canvas);
    };

    // Defer past LCP — rIC where supported, setTimeout fallback (Safari).
    if ("requestIdleCallback" in window) {
      (window as Window & typeof globalThis).requestIdleCallback(setupIO, { timeout: 2000 });
    } else {
      setTimeout(setupIO, 1);
    }
  }

  function updateTime() {
    const el = document.querySelector<HTMLElement>("[data-local-time]");
    if (!el) return;
    const time = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
      timeZone: "Asia/Kolkata",
    }).format(new Date());
    el.textContent = `${time} local time`;
  }

  // WMO weather codes — https://open-meteo.com/en/docs#weather_variable_documentation
  function describeWeather(code: number, isDay: boolean) {
    if (code === 0) return { emoji: isDay ? "☀️" : "🌙", label: isDay ? "Sunny" : "Clear" };
    if (code <= 2) return { emoji: isDay ? "⛅" : "☁️", label: "Partly cloudy" };
    if (code === 3) return { emoji: "☁️", label: "Overcast" };
    if (code <= 48) return { emoji: "🌫️", label: "Foggy" };
    if (code <= 57) return { emoji: "🌦️", label: "Drizzly" };
    if (code <= 67) return { emoji: "🌧️", label: "Rainy" };
    if (code <= 77) return { emoji: "🌨️", label: "Snowy" };
    if (code <= 82) return { emoji: "🌦️", label: "Showers" };
    if (code <= 86) return { emoji: "🌨️", label: "Snow" };
    return { emoji: "⛈️", label: "Stormy" };
  }

  async function updateWeather() {
    const card = document.querySelector<HTMLElement>("[data-weather]");
    const tempEl = document.querySelector<HTMLElement>("[data-weather-temp]");
    const emojiEl = document.querySelector<HTMLElement>("[data-weather-emoji]");
    if (!card || !tempEl || !emojiEl) return;
    try {
      const r = await fetch(
        "https://api.open-meteo.com/v1/forecast?latitude=12.9716&longitude=77.5946&current=temperature_2m,weather_code,is_day&timezone=Asia%2FKolkata",
      );
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const data = await r.json();
      const c = data.current;
      const { emoji, label } = describeWeather(c.weather_code, c.is_day === 1);
      emojiEl.textContent = emoji;
      tempEl.textContent = `${Math.round(c.temperature_2m)}° · ${label}`;
    } catch {
      card.style.opacity = "0";
    }
  }

  function scheduleWeather() {
    const start = () => {
      updateWeather();
      setInterval(updateWeather, 30 * 60 * 1000);
    };
    if ("requestIdleCallback" in window) {
      (window as Window & typeof globalThis).requestIdleCallback(start, { timeout: 3000 });
    } else {
      setTimeout(start, 1);
    }
  }

  function init() {
    mountGlobe();
    updateTime();
    setInterval(updateTime, 30_000);
    scheduleWeather();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

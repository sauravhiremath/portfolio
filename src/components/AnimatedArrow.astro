---
import Icons from "./Icons.astro";

interface Props {
  direction?: "up-right" | "left";
  size?: number;
}

const { direction = "up-right", size = 16 } = Astro.props;
const iconName = direction === "left" ? "arrow-left" : "arrow-up-right";
---

<span class:list={["arrow-anim", `dir-${direction}`]} aria-hidden="true">
  <Icons name={iconName} size={size} />
</span>

<style is:global>
  .arrow-anim {
    display: inline-flex;
    flex-shrink: 0;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  a:hover .arrow-anim.dir-up-right { transform: translate(3px, -3px); }
  a:hover .arrow-anim.dir-left { transform: translate(-3px, 0); }

  a:active .arrow-anim { transform: scale(0.85); }

  @media (prefers-reduced-motion: reduce) {
    .arrow-anim {
      transition: none;
    }
  }
</style>
